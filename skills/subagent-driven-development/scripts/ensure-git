#!/usr/bin/env bash
# Compatibility wrapper for the approved, baseline-only Building preflight.
# Usage: ensure-git BUILD_PLAN SPEC_APPROVAL_JSON
set -euo pipefail
if [ $# -ne 2 ]; then
  echo "usage: ensure-git BUILD_PLAN SPEC_APPROVAL_JSON" >&2
  exit 2
fi
here=$(cd "$(dirname "$0")" && pwd)
python_exe=${SDD_PYTHON:-python}
if ! command -v "$python_exe" >/dev/null 2>&1; then python_exe=python3; fi
exec "$python_exe" "$here/sdd-harness.py" prepare-git "$1" --evidence "$2"
